DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=public"

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auto-generated secret for JWT signing (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Only this email can access the admin panel
ADMIN_EMAIL="admin@example.com"

# Supabase (get from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Calendly scheduling link used by the "Schedule via Calendly" button (contact section)
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/mehlem-clinic/consultation"

# Messaging links for contact section icon buttons
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/38761123456"
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/yourusername"
